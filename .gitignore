node_modules
# `dist/` fica versionado DE PROPÓSITO: é o que dá o link público
# permanente (GitHub Pages + CDN a servir os ficheiros do GitHub, sem
# depender deste computador). Não voltes a pôr `dist` aqui.
*.local
# Cópia de segurança do `.git` que existia dentro de `dist/` (lixo antigo).
.backup-dist-git-*
.env
.env.*
!.env.example
.DS_Store
.vite
*.log
dist/.git-backup-*
.vercel

# Cópias de segurança locais dos documentos
documentos/*.bak*
